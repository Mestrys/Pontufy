{
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "functions": {
    "src/app/api/rewards/autopilot/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/expire-points",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/link-health",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/rewards-sync",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/sync-lomadee",
      "schedule": "0 8 * * *"
    }
  ]
}