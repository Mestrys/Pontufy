generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════════
// Modelo de Dados Core - Pontufy B2B MVP
// ═══════════════════════════════════════════════════════════════════════

model Tenant {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String?  @default("#10B981") // Padrão Verde Esmeralda Pontufy
  accentColor     String?  @default("#8B5CF6") // Padrão Lavanda/Roxo
  customDomain    String?  @unique
  sector          String   // 'tech', 'health', 'retail', 'industry'
  contractStatus  String   @default("active") // 'active', 'suspended', 'cancelled'
  plan            String   @default("trial") // 'trial', 'starter', 'enterprise'
  trialEndsAt     DateTime?
  aiCredits       Int      @default(20)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  subscriptionStatus   String?  // 'active', 'past_due', 'canceled', 'trialing'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  locale          String   @default("pt-BR")  // 'pt-BR', 'en', 'es'

  users              User[]
  courses            Course[]
  pointsLedger       PointsLedger[]
  rewards            Reward[]
  invitations        Invitation[]
  lessonCompletions  LessonCompletion[]
  commissions        Commission[]
  notifications      Notification[]
  stripeEvents       StripeEvent[]
  auditLogs          AuditLog[]
  quizAttempts       QuizAttempt[]
}

model User {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  email           String   @unique
  passwordHash    String?  // scrypt: "<salt>:<hash>". Null only for legacy/migrated accounts.
  role            String   @default("employee") // 'admin_rh', 'employee', 'guest'
  pointsBalance   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  pointsLedger        PointsLedger[]
  lessonCompletions   LessonCompletion[]
  passwordReset       PasswordReset?
  issuedCertificates  IssuedCertificate[]
  commissions         Commission[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  quizAttempts        QuizAttempt[]

  @@index([tenantId])
  @@index([tenantId, pointsBalance])
}

model Course {
  id              String   @id @default(uuid())
  tenantId        String
  title           String
  description     String?
  aiCreditsSpent  Int      @default(0)
  quizJson        String?  // JSON array of module quizzes from AI generation
  status          String   @default("draft") // 'draft', 'published'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  lessons         Lesson[]
  quizAttempts    QuizAttempt[]

  workloadHours   Int      @default(0) // Carga horária oficial do curso (certificado). 0 = fallback para nº de aulas.

  @@index([tenantId])
}

model Lesson {
  id              String   @id @default(uuid())
  courseId        String
  title           String
  type            String   // 'video', 'text'
  contentUrl      String?  @db.Text
  pointsAssigned  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]

  @@index([courseId])
}

model LessonCompletion {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  lessonId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([tenantId])
}

model QuizAttempt {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  courseId  String
  score     Int
  total     Int
  passed    Boolean  @default(false) // score/total >= 70% (server-side)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
  @@index([tenantId])
}

model PointsLedger {
  id              String   @id @default(uuid())
  userId          String
  tenantId        String
  type            String   // 'gain', 'loss'
  pointsAmount    Int
  description     String
  timestamp       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@index([userId, timestamp])
}

model Reward {
  id              String   @id @default(uuid())
  tenantId        String?  // Null = global reward available to all tenants.
  partnerStore    String   // 'amazon', 'magalu', 'shopee', 'mercadolivre'
  title           String
  affiliateLink   String
  pricePoints     Int
  imageUrl        String?
  category        String?  // 'tech', 'health', 'home', 'coupons'
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @unique
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String   // ex.: "COURSE_CREATED", "USER_ROLE_UPDATED", "POINTS_MANUAL_ADJUST"
  entity     String   // ex.: "Course", "User", "Reward", "Tenant", "Invitation"
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

model Invitation {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  token     String   @unique
  role      String   @default("employee") // 'admin_rh', 'employee', 'guest'
  status    String   @default("pending") // 'pending', 'accepted', 'expired'
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@index([token])
}

// ═══════════════════════════════════════════════════════════════════════
// Idempotência de webhooks Stripe
// ───────────────────────────────────────────────────────────────────────
// Registro de eventos processados para impedir créditos/ativações duplicadas
// (Stripe redelivers até obter 2xx). `eventId` é único globalmente.
// ═══════════════════════════════════════════════════════════════════════

model StripeEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  type        String
  tenantId    String?
  processedAt DateTime @default(now())

  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([type])
  @@index([tenantId])
}

model IssuedCertificate {
  id               String   @id @default(uuid())
  userId           String
  tenantId         String
  courseId         String
  courseName       String
  verificationHash String?  @unique // Código único de verificação impresso no PDF
  issuedAt         DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════════════════════
// Notificações in-app (Centro de Notificações em Tempo Real)
// ───────────────────────────────────────────────────────────────────────
// Pertencem a um utilizador e tenant específicos (Zero Trust: leitura e
// escrita sempre via getTenantDb). `read` controla o badge não-lido.
// ═══════════════════════════════════════════════════════════════════════

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  title     String
  message   String
  type      String   // "POINTS_EARNED" | "REWARD_REDEEMED" | "COURSE_ASSIGNED" | "LEVEL_UP" | "SYSTEM"
  read      Boolean  @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, read])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════
// Comissões de afiliados (Postback)
// ───────────────────────────────────────────────────────────────────────
// Registro persistente de cada postback recebido das redes afiliadas.
// Idempotência: um (tenantId, orderId, network) só pode ser processado
// uma vez — o crédito de pontos acontece dentro de uma $transaction.
// ═══════════════════════════════════════════════════════════════════════

model Commission {
  id              String   @id @default(uuid())
  tenantId        String
  network         String   // 'amazon', 'magalu', 'shopee', 'mercadolivre'
  trackingId      String
  userId          String
  orderId         String
  orderValue      Decimal  @db.Decimal(12, 2)
  commissionValue Decimal  @db.Decimal(12, 2)
  currency        String   @default("BRL")
  status          String   @default("pending") // 'pending', 'approved', 'rejected'
  pointsAwarded   Int      @default(0)
  receivedAt      DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@unique([tenantId, network, orderId])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
}
