# URL e chave anon do projeto Supabase
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"

# Deve bater com app_config.server_secret no banco (gere com: openssl rand -hex 32)
APP_SERVER_SECRET="<server-secret>"

# Assinatura dos JWTs do Auth.js (gere com: openssl rand -hex 32)
AUTH_SECRET="<auth-secret>"

# URL da landing page (dev: http://localhost:3000)
NEXT_PUBLIC_LANDING_URL="https://pontufy.com"

# Motor de IA da geração de cursos: "ollama" (local/dev) ou "groq" (produção)
AI_PROVIDER="ollama"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
# Groq (https://console.groq.com — free tier): necessário quando AI_PROVIDER="groq"
# GROQ_API_KEY="<groq-api-key>"
# GROQ_MODEL="llama3-70b-8192"
